#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

NULL_SHA="0000000000000000000000000000000000000000"

# Skip for fresh worktrees (dependencies won't be installed yet)
if [ "$1" = "$NULL_SHA" ]; then
    echo "Fresh worktree detected, skipping post-checkout hooks (run pnpm install)"
    exit 0
fi

# Check if pnpm-lock.yaml changed and remind developer to run pnpm install
changed_files="$(git diff-tree -r --name-only --no-commit-id "$1" "$2")"
if echo "$changed_files" | grep --quiet "pnpm-lock.yaml"; then
    echo ""
    echo "pnpm-lock.yaml has changed. You may need to run 'pnpm install' to update dependencies."
    echo ""
fi

# make sure composer packages are installed and the autoload files are regenerated
# --ignore-platform-req=php allows dev-only packages (like qit-cli) that need PHP 7.4+
composer install --ignore-platform-req=php
