#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

NULL_SHA="0000000000000000000000000000000000000000"

# Skip for fresh worktrees (dependencies won't be installed yet)
if [ "$1" = "$NULL_SHA" ]; then
    echo "Fresh worktree detected, skipping post-checkout hooks (run pnpm install)"
    exit 0
fi

. "$(dirname "$0")/install-deps.sh" "$1" "$2"
