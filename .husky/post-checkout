#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Run yarnhook if available (won't be available in fresh worktrees before npm install)
# The || true ensures we don't fail the hook if yarnhook isn't installed yet
npx --no-install yarnhook 2>/dev/null || true

# Make sure composer packages are installed and the autoload files are regenerated
# --ignore-platform-req=php allows dev-only packages (like qit-cli) that need PHP 7.4+
# The || true ensures we don't fail the hook if composer fails (e.g., fresh worktree)
composer install --ignore-platform-req=php 2>/dev/null || true

# Auto-configure Docker port for new worktrees
if [ -f "bin/docker-port-setup.sh" ]; then
    bash bin/docker-port-setup.sh 2>/dev/null || true
fi
