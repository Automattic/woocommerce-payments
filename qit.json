{
  "wp": "stable",
  "php_version": "7.4",
  "plugins": {
    "woocommerce": {
      "action": "activate"
    },
    "wordpress-importer": {
      "action": "activate"
    },
    "woocommerce-payments": {
      "source": "../woocommerce-payments",
      "action": "test",
      "test_tags": ["./tests/qit/e2e"]
    },
    "woocommerce-payments-dev-tools": {
      "source": "../woocommerce-payments-dev-tools",
      "action": "activate"
    }
  },
  "themes": {
    "storefront":  {
      "source": "https://downloads.wordpress.org/theme/storefront.zip",
      "action": "activate"
    },
    "twentytwentyfour": {
      "source": "https://downloads.wordpress.org/theme/twentytwentyfour.zip",
      "action": "activate"
    }
  }
}