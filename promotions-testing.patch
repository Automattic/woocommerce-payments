+	/**
+	 * Get mock promotions data for testing.
+	 * TODO: Remove this method when server endpoints are available.
+	 *
+	 * @return array Mock promotions data.
+	 */
+	private function get_mock_promotions_data() {
+		$current_time = time();
+		$activated    = self::get_activated_promotions();
+
+		// Mock available promotions.
+		$available_promotions = [
+			[
+				'identifier'     => 'promo-card-waive-2024',
+				'name'           => 'Zero Processing Fees for Card Payments',
+				'payment_method' => 'card',
+				'duration_days'  => 90,
+				'status'         => 'offered',
+				'terms_url'      => 'https://woocommerce.com/terms',
+			],
+			[
+				'identifier'     => 'promo-affirm-cashback-2024',
+				'name'           => '2% Cashback on Affirm Transactions',
+				'payment_method' => 'affirm',
+				'duration_days'  => 60,
+				'status'         => 'offered',
+				'terms_url'      => 'https://woocommerce.com/terms',
+			],
+		];
+
+		// Mock active promotions - check if any have been activated.
+		$active_promotions = [];
+		foreach ( $activated as $identifier => $activated_at ) {
+			$duration_days  = 90; // Default duration.
+			$expires_at     = $activated_at + ( $duration_days * DAY_IN_SECONDS );
+			$days_remaining = max( 0, ceil( ( $expires_at - $current_time ) / DAY_IN_SECONDS ) );
+
+			$active_promotions[] = [
+				'identifier'     => $identifier,
+				'name'           => 'Activated Promotion: ' . $identifier,
+				'payment_method' => 'card',
+				'duration_days'  => $duration_days,
+				'status'         => 'active',
+				'activated_at'   => gmdate( 'Y-m-d\TH:i:s\Z', $activated_at ),
+				'expires_at'     => gmdate( 'Y-m-d\TH:i:s\Z', $expires_at ),
+				'days_remaining' => $days_remaining,
+			];
+		}
+
+		return [
+			'available_promotions' => $available_promotions,
+			'active_promotions'    => $active_promotions,
+		];
+	}
