# QIT E2E Testing Configuration for WooCommerce Payments
# Copy this file to local.env and update with your values

# ===========================================
# BASIC CONNECTIVITY TESTING (Mock Stripe)
# ===========================================
# These provide basic WCPay plugin connectivity without real payment processing
# Suitable for testing: admin screens, onboarding flow, plugin activation
E2E_JP_SITE_ID=your_site_id_here
E2E_JP_BLOG_TOKEN=your_blog_token_here
E2E_JP_USER_TOKEN=your_user_token_here

# ===========================================
# CHECKOUT FLOW TESTING (Real Stripe)
# ===========================================
# These enable real payment processing for comprehensive E2E testing
# Suitable for testing: checkout flows, payment methods, transaction processing

# REQUIRED: Real Stripe test account credentials
# Get these from your Stripe Dashboard (test mode)
E2E_STRIPE_PUBLISHABLE_KEY=pk_test_your_real_stripe_test_key_here
E2E_STRIPE_ACCOUNT_ID=acct_your_real_stripe_account_id_here

# OPTIONAL: Enable live mode (USE WITH EXTREME CAUTION!)
# Only set this if you need to test live transactions
# E2E_STRIPE_LIVE_MODE=1

# ===========================================
# QIT CLI CREDENTIALS
# ===========================================
QIT_CI_USER=your_qit_username
QIT_CI_SECRET=your_qit_application_password

# Test configuration
NODE_ENV=production
DEBUG=false

# Optional: Override default test configuration
# E2E_GROUP=wcpay
# E2E_BRANCH=merchant

# ===========================================
# HOW TO GET STRIPE CREDENTIALS
# ===========================================
# 1. Log into your Stripe Dashboard (https://dashboard.stripe.com)
# 2. Ensure you're in "Test mode" (toggle in top-left)
# 3. Go to "Developers" > "API keys"
# 4. Copy the "Publishable key" (starts with pk_test_)
# 5. For Account ID: Go to "Settings" > "Account details" and copy Account ID (starts with acct_)

# ===========================================
# USAGE EXAMPLES
# ===========================================
# Basic connectivity: Set only E2E_JP_* variables (mock Stripe, admin access only)
# Checkout testing: Set E2E_STRIPE_* variables (real test payments work)
# Live testing: Add E2E_STRIPE_LIVE_MODE=1 (DANGER: real money!)

# Require WCPay authentication to succeed (fail setup if init fails)
# Set to 1 in CI if you need to hard-enforce authenticated runs
# E2E_REQUIRE_WCPAY_AUTH=0
