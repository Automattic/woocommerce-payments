{
    "$schema": "https://qit.woo.com/json-schema/qit",
    "sut": {
        "type": "plugin",
        "slug": "woocommerce-payments",
        "source": {
            "type": "local",
            "path": "../woocommerce-payments/woocommerce-payments.zip"
        }
    },
    "environments": {
        "default": {
            "php": "8.3",
            "wp": "stable",
            "woo": "stable",
            "plugins": [
                "woocommerce",
                "jetpack"
            ],
            "themes": [
                "storefront"
            ],
            "env": {
                "E2E_JP_SITE_ID": "${E2E_JP_SITE_ID}",
                "E2E_JP_BLOG_TOKEN": "${E2E_JP_BLOG_TOKEN}",
                "E2E_JP_USER_TOKEN": "${E2E_JP_USER_TOKEN}"
            }
        }
    },
    "test_types": {
        "e2e": {
            "default": {
                "test_packages": [
                    "."
                ],
                "environment": "default"
            }
        }
    }
}
