{
  "extends": [
    "config:base"
  ],
  "patch": {
    "automerge": true
  },
  "pin": {
    "automerge": true
  },
  "rebaseWhen": "conflicted",
  "schedule": [
    "before 3am on Sunday"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["^@wordpress/", "^@woocommerce/"],
      "enabled": false,
      "description": "Ignore @wordpress/* and @woocommerce/* updates — these need to be synced to min WP/WC versions"
    }
  ]
}
