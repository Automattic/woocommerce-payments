@@ -0,0 +1,141 @@
+/** @format */
+
+.wcpay-spotlight {
+	position: fixed;
+	bottom: 24px;
+	right: 24px;
+	z-index: 999;
+	max-width: 380px;
+	opacity: 0;
+	transform: translateX( 100% );
+	transition: opacity 0.3s ease-out, transform 0.3s ease-out;
+
+	&--visible {
+		opacity: 1;
+		transform: translateX( 0 );
+	}
+
+	@media screen and ( max-width: 782px ) {
+		right: 0;
+		left: 0;
+		bottom: 0;
+		max-width: none;
+
+		.wcpay-spotlight__card {
+			margin: 0;
